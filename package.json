{
  "name": "plimsoll",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only usage monitoring for AI chat providers. Reports usage; never modifies, bypasses, or extends any provider's limits.",
  "license": "MIT",
  "homepage": "https://plimsoll.anubris.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sariamubeen/plimsoll.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/extension/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sanitize": "node scripts/sanitize-fixture.ts",
    "check:pii": "vitest run tests/no-pii.test.ts tests/sanitize-fixture.test.ts",
    "check:secrets": "secretlint --secretlintignore .gitignore \"**/*\"",
    "check:privacy": "pnpm run check:pii && pnpm run check:secrets",
    "prepare": "husky",
    "build:monitor": "cross-env PLIMSOLL_TARGET=monitor pnpm --filter @plimsoll/extension exec wxt build",
    "build:full": "cross-env PLIMSOLL_TARGET=full pnpm --filter @plimsoll/extension exec wxt build",
    "check:target": "node scripts/check-target.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run check:privacy",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.ts",
    "icons": "node scripts/icons.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "happy-dom": "^20.11.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "secretlint": "13.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*": "secretlint --secretlintignore .gitignore",
    "*.{ts,tsx,js,mjs}": "eslint --fix",
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": "prettier --write"
  }
}
