{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // No baseUrl: it is deprecated in TS 7 and paths already resolve relative to
    // this file. Keeping it would be a migration blocker for no benefit.
    "paths": {
      "@plimsoll/core/*": ["./packages/core/*.ts"],
      "@plimsoll/adapters/*": ["./packages/adapters/*.ts"],
      "@plimsoll/ui/*": ["./packages/ui/*.tsx", "./packages/ui/*.ts"]
    },

    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,

    // Scripts are executed directly by Node's type-stripping loader, which
    // cannot transform enums or namespaces. Keep every construct erasable.
    "erasableSyntaxOnly": true,

    "noEmit": true,
    // Sources import each other with explicit .ts specifiers so Node's type-stripping
    // loader can run scripts/ directly with no build step.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "*.config.ts"
  ],
  // apps/extension is a SEPARATE project (apps/extension/tsconfig.json), because it
  // needs WXT's generated .wxt/tsconfig.json for `wxt/browser` and the ambient
  // globals to resolve. Including it here too would make ESLint's project service
  // pick this config for those files, where `browser` degrades to an error type and
  // every call on it becomes an unchecked `any`.
  "exclude": ["node_modules", "dist", ".output", ".wxt", "**/.output/**", "**/.wxt/**"]
}
