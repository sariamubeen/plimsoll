{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,

    // Scripts are executed directly by Node's type-stripping loader, which
    // cannot transform enums or namespaces. Keep every construct erasable.
    "erasableSyntaxOnly": true,

    "noEmit": true,
    // Sources import each other with explicit .ts specifiers so Node's type-stripping
    // loader can run scripts/ directly with no build step.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "dist", ".output", ".wxt"]
}
